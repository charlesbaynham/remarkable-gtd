{#- ============================================================
    GTD reMarkable Sheet — Jinja2 template (Playwright/Chromium)
    Renders ONE tall, auto-height page per bucket — exactly the
    layout approved in the HTML preview (same gtd.css). generate.py
    renders one bucket at a time, measures its height, and emits a
    PDF page cut to fit. `qr(text)` is a Jinja global -> PNG data-URI.
    data-roi attributes mark every region the scanner samples; the
    deterministic pipeline reads them without a model in the loop.
    ============================================================ -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>GTD — {{ date_long }}</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="gtd.css" />
</head>
<body>

{#- ---------- reusable macros (mirror gtd-render.js) ---------- -#}
{% macro cell(tid, verb, gl, label) -%}
<div class="cell"><div class="box" data-roi="{{ tid }}:{{ verb }}"></div><div class="gl">{{ gl }}</div><div class="cl">{{ label }}</div></div>
{%- endmacro %}

{% macro defer(tid, stem, heading) -%}
<div class="defer">
  <div class="dh">{{ heading }}</div>
  <div class="trio">
    <div class="dcell"><div class="box" data-roi="{{ tid }}:{{ stem }}_1w"></div><div class="cl">1w</div></div>
    <div class="dcell"><div class="box" data-roi="{{ tid }}:{{ stem }}_1m"></div><div class="cl">1m</div></div>
    <div class="dcell"><div class="box" data-roi="{{ tid }}:{{ stem }}_1q"></div><div class="cl">1q</div></div>
  </div>
</div>
{%- endmacro %}

{#- ✦ AI is the escape hatch, not an annotation: ticking it switches the
    deterministic rules off for that row and hands the whole row to the
    agent, which then owns the only write. A blank write-in row gets it
    too — on a `newproj` row it is the way to say more than a name. -#}
{% macro gutter(cat, tid, capture=False, starred=False) -%}
<div class="gut">
{%- if cat == 'inbox' -%}
  {{ cell(tid, 'to_next', '→', 'Next') }}{{ cell(tid, 'to_deleg', '→', 'Deleg') }}{{ defer(tid, 'defer', 'Defer') }}{{ cell(tid, 'drop', '✗', 'Drop') }}{% if not capture %}{{ cell(tid, 'ai', '✦', 'AI') }}{% endif %}
{%- elif cat == 'newproj' -%}
  {{ cell(tid, 'to_next', '→', 'Next') }}{{ cell(tid, 'to_deleg', '→', 'Deleg') }}{{ defer(tid, 'defer', 'Defer') }}{{ cell(tid, 'drop', '✗', 'Drop') }}{{ cell(tid, 'ai', '✦', 'AI') }}
{%- elif cat == 'delegated' -%}
  {{ cell(tid, 'done', '✓', 'Done') }}{{ cell(tid, 'to_me', '↩', 'To me') }}{{ defer(tid, 'defer', 'Defer') }}{{ cell(tid, 'ai', '✦', 'AI') }}
{%- elif cat == 'tickler' -%}
  {{ cell(tid, 'activate', '→', 'Now') }}{{ cell(tid, 'done', '✓', 'Done') }}{{ defer(tid, 'redefer', 'Re-defer') }}{{ cell(tid, 'ai', '✦', 'AI') }}
{%- elif cat == 'project' -%}
  {{ cell(tid, 'done', '✓', 'Done') }}{{ cell(tid, 'to_deleg', '→', 'Deleg') }}{{ defer(tid, 'defer', 'Defer') }}{{ cell(tid, 'drop', '✗', 'Drop') }}{{ cell(tid, 'ai', '✦', 'AI') }}
{%- elif cat == 'projhead' -%}
  {{ cell(tid, 'done', '✓', 'Finish') }}{{ cell(tid, 'star', '☆' if starred else '★', 'Unstar' if starred else 'Star') }}{{ cell(tid, 'ai', '✦', 'AI') }}
{%- else -%}
  {{ cell(tid, 'done', '✓', 'Done') }}{{ cell(tid, 'to_deleg', '→', 'Deleg') }}{{ defer(tid, 'defer', 'Defer') }}{{ cell(tid, 'ai', '✦', 'AI') }}
{%- endif -%}
</div>
{%- endmacro %}

{#- The NEW box lives inside the PROJECT field so the two never wrap
    apart: tick it to say the project written in the slot is a new one. -#}
{% macro newbox(tid) -%}
<span class="newbox"><span class="box" data-roi="{{ tid }}:new_project"></span><span class="cl">New</span></span>
{%- endmacro %}

{% macro fld_proj_blank(tid) -%}
<span class="fld"><span class="fl">Project</span><span class="slot m" data-roi="{{ tid }}:slot_project"></span>{{ newbox(tid) }}</span>
{%- endmacro %}

{% macro fld_proj_cur(tid, cur) -%}
<span class="fld"><span class="fl">Project</span><span class="cur tag">{{ cur }}</span><span class="arr">→</span><span class="slot m" data-roi="{{ tid }}:slot_project"></span>{{ newbox(tid) }}</span>
{%- endmacro %}

{% macro fld_cur(tid, label, cur, slot_cls, slot_name, tag=False) -%}
<span class="fld"><span class="fl">{{ label }}</span><span class="cur{{ ' tag' if tag }}">{{ cur }}</span><span class="arr">→</span><span class="slot {{ slot_cls }}" data-roi="{{ tid }}:slot_{{ slot_name }}"></span></span>
{%- endmacro %}

{% macro fld_blank(tid, label, slot_cls, slot_name) -%}
<span class="fld"><span class="fl">{{ label }}</span><span class="slot {{ slot_cls }}" data-roi="{{ tid }}:slot_{{ slot_name }}"></span></span>
{%- endmacro %}

{% macro fld_prom(tid, label, cur, slot_cls, slot_name) -%}
<span class="fld prominent"><span class="fl">{{ label }}</span><span class="cur">{{ cur }}</span><span class="arr">→</span><span class="slot {{ slot_cls }}" data-roi="{{ tid }}:slot_{{ slot_name }}"></span></span>
{%- endmacro %}

{% macro fields(cat, t) -%}
{%- if cat == 'newproj' -%}
{#- The PROJECT slot names the project being created; there is no NEW box
    because every row on this page is a new project. A routing tick means
    "on reflection this is not a project" and the slot then names an
    existing project to file the text under, exactly as on the Inbox. -#}
<div class="fields">{{ fld_blank(t.id, 'Priority', 'n', 'priority') }}{{ fld_blank(t.id, 'Due', 's', 'due') }}{{ fld_blank(t.id, 'Project', 'm', 'project') }}{{ fld_blank(t.id, 'To', 'to', 'to') }}</div>
{%- elif cat == 'inbox' -%}
<div class="fields">{{ fld_blank(t.id, 'Priority', 'n', 'priority') }}{{ fld_blank(t.id, 'Due', 's', 'due') }}{{ fld_proj_blank(t.id) }}{{ fld_blank(t.id, 'To', 'to', 'to') }}</div>
{%- elif cat == 'delegated' -%}
<div class="fields">{{ fld_prom(t.id, 'To', t.to, 'to', 'to') }}{{ fld_cur(t.id, 'Priority', t.pri, 'n', 'priority') }}{{ fld_cur(t.id, 'Due', t.due, 's', 'due') }}{{ fld_proj_cur(t.id, t.proj) }}</div>
{%- elif cat == 'project' -%}
{#- A project step is an ordinary action: DUE is the chase-by date when it
    is delegated, TO the person it is delegated to. -#}
<div class="fields">{{ fld_blank(t.id, 'Due', 's', 'due') }}{{ fld_blank(t.id, 'To', 'to', 'to') }}</div>
{%- elif cat == 'projhead' -%}
{#- The project itself: a new name and a new goal, each on its own line.
    Leave a slot blank to keep what is printed. -#}
<div class="fields"><span class="fld wide"><span class="fl">Rename to</span><span class="slot name" data-roi="{{ t.id }}:slot_name"></span></span><span class="fld wide"><span class="fl">New goal</span><span class="slot tall" data-roi="{{ t.id }}:slot_goal"></span></span></div>
{%- elif cat == 'tickler' -%}
{#- no metadata -#}
{%- else -%}
<div class="fields">{{ fld_cur(t.id, 'Priority', t.pri, 'n', 'priority') }}{{ fld_cur(t.id, 'Due', t.due, 's', 'due') }}{{ fld_proj_cur(t.id, t.proj) }}{{ fld_blank(t.id, 'To', 'to', 'to') }}</div>
{%- endif -%}
{%- endmacro %}

{#- A capture row is a normal row whose action is a blank ruled write-in
    area (data-roi <id>:act) instead of printed text. On a project page it
    carries no gutter and no fields — just somewhere to add an action. -#}
{% macro row(cat, t) -%}
<div class="row" data-roi="{{ t.id }}:row">
  <div class="row-top">
    <div class="rail">
      <span class="qr" data-roi="{{ t.id }}:qr"><img src="{{ qr(t.id) }}" alt="{{ t.id }}" /></span>
      <span class="code mono">{{ t.id }}</span>
    </div>
    <div class="act-wrap">
      {% if t.capture %}
      <div class="act cap" data-roi="{{ t.id }}:act"></div>
      {% else %}
      <div class="act" data-roi="{{ t.id }}:act">{{ t.act }}{% if t.badge %} <span class="badge">{{ t.badge }}</span>{% endif %}</div>
      {% endif %}
    </div>
    {% if not t.bare %}{{ gutter(cat, t.id, t.capture, t.starred) }}{% endif %}
  </div>
  {% if not t.bare %}{{ fields(cat, t) }}{% endif %}
</div>
{%- endmacro %}

{% macro legend(cat) -%}
<div class="legend"><span class="lt">Tick to</span>
{%- if cat == 'inbox' -%}
  <span class="k"><span class="kb">→</span><span class="kl">to Next Actions</span></span>
  <span class="k"><span class="kb">→</span><span class="kl">to Delegated</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">Defer to Tickler</span></span>
  <span class="k"><span class="kb">✗</span><span class="kl">Drop</span></span>
  <span class="k"><span class="kb">✦</span><span class="kl">AI decides this row</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">New = create this project</span></span>
{%- elif cat == 'delegated' -%}
  <span class="k"><span class="kb">✓</span><span class="kl">Done</span></span>
  <span class="k"><span class="kb">↩</span><span class="kl">Back to me</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">Defer 1w/1m/1q</span></span>
  <span class="k"><span class="kb">✦</span><span class="kl">AI decides this row</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">New = create this project</span></span>
{%- elif cat == 'tickler' -%}
  <span class="k"><span class="kb">→</span><span class="kl">Activate now</span></span>
  <span class="k"><span class="kb">✓</span><span class="kl">Done</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">Re-defer</span></span>
  <span class="k"><span class="kb">✦</span><span class="kl">AI decides this row</span></span>
{%- elif cat == 'newproj' -%}
  <span class="k"><span class="kb">▢</span><span class="kl">Write it, get a project</span></span>
  <span class="k"><span class="kb">→</span><span class="kl">Not a project → Next / Deleg</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">Defer to Tickler</span></span>
  <span class="k"><span class="kb">✗</span><span class="kl">Drop</span></span>
  <span class="k"><span class="kb">✦</span><span class="kl">AI decides this row</span></span>
{%- elif cat == 'project' -%}
  <span class="k"><span class="kb">✓</span><span class="kl">Done</span></span>
  <span class="k"><span class="kb">→</span><span class="kl">Delegate (TO, DUE = chase)</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">Defer 1w/1m/1q</span></span>
  <span class="k"><span class="kb">✗</span><span class="kl">Drop the step</span></span>
  <span class="k"><span class="kb">✦</span><span class="kl">AI decides this row</span></span>
  <span class="k"><span class="kb">✓</span><span class="kl">Finish = whole project → Done/</span></span>
  <span class="k"><span class="kb">★</span><span class="kl">Star / unstar = pin to the top</span></span>
{%- else -%}
  <span class="k"><span class="kb">✓</span><span class="kl">Done</span></span>
  <span class="k"><span class="kb">→</span><span class="kl">Delegate</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">Defer 1w/1m/1q</span></span>
  <span class="k"><span class="kb">✦</span><span class="kl">AI decides this row</span></span>
  <span class="k"><span class="kb">▢</span><span class="kl">New = create this project</span></span>
{%- endif -%}
</div>
{%- endmacro %}

{#- ---------- one bucket = one tall page ---------- -#}
{% for b in buckets %}
<section class="page" data-bucket="{{ b.key }}">
  <div class="reg tl" data-roi="reg:tl"></div><div class="reg tr" data-roi="reg:tr"></div><div class="reg bl" data-roi="reg:bl"></div><div class="reg br" data-roi="reg:br"></div>

  <div class="head">
    <div class="head-l">
      <div class="head-tag">{{ b.tag }}</div>
      <div>
        <div class="head-title">{% if b.starred %}★ {% endif %}{{ b.title }}</div>
        <div class="head-sub">{{ b.sub }}</div>
      </div>
    </div>
    <div class="head-r">
      <div class="big">{{ date_long }}</div>
      <div class="mono">{{ b.count_label }}</div>
      <div style="display:flex;justify-content:flex-end"><span class="head-qr" data-roi="page:qr"><img src="{{ qr('GTD|' ~ b.key ~ '|' ~ date_stamp) }}" alt="page code" /></span></div>
    </div>
  </div>

  {#- The hotbar: every starred project, one tap away from every page.
      `@hot` keeps the key unique on the summary, which links P01 too. -#}
  {% if b.hotbar %}
  <div class="hotbar"><span class="hl">★</span>{% for h in b.hotbar %}<span class="hot" data-roi="link:{{ h.ref }}@hot">{{ h.name }}</span>{% endfor %}</div>
  {% endif %}

  {% if b.kind == 'summary' %}
  {#- Project summary: a read-only index. Each block links to that
      project's own page (data-roi link:P01 -> a PDF GoTo annotation). -#}
  <div class="rows">
    {% for p in b['projects'] %}
    <div class="proj-block" data-roi="link:{{ p.ref }}">
      <div class="pname">{% if p.starred %}★ {% endif %}{{ p.name }}</div>
      {% if p.goal %}<div class="pgoal">{{ p.goal }}</div>{% endif %}
      <div class="pmeta">
        <span class="mono">{{ p.ref }} · p{{ p.page_no }}</span>
        <span class="mono">{{ p.open_count }} open</span>
        <span class="badge{{ ' stalled' if p.badge == 'STALLED' }}">{{ p.badge }}</span>
      </div>
      {% if p.next_action %}<div class="pna"><span class="pl">Next</span>{{ p.next_action }}</div>{% endif %}
    </div>
    {% endfor %}
    {% if not b['projects'] %}<div class="empty">No projects.</div>{% endif %}
    {% if b['new_page_ref'] %}
    <div class="proj-block" data-roi="link:{{ b['new_page_ref'] }}">
      <div class="pname">+ Start a new project</div>
      <div class="pgoal">Blank rows on the last page of this sheet — write one per project.</div>
      <div class="pmeta"><span class="mono">p{{ b['new_page_no'] }}</span></div>
    </div>
    {% endif %}
  </div>

  {% elif b.kind == 'newproj' %}
  {#- Blank rows for projects that do not exist yet: write the first action
      on the line, the project's name in the PROJECT box. Same routing
      gutter as the Inbox, so a row that turns out not to be a project can
      still go to Next / Delegated / Tickler / the bin, or to the agent. -#}
  <div class="proj-head">
    <div class="pgoal">Write the first action on the line and the project's name in the PROJECT box. Tick nothing else and the project is created with that action as its first. Tick a routing box instead and it is filed like any Inbox item.</div>
    <div><span class="backlink" data-roi="link:projects">← Projects</span></div>
  </div>

  {{ legend('newproj') }}

  <div class="rows">
    {% for t in b['items'] %}{{ row('newproj', t) }}{% endfor %}
  </div>

  {% elif b.kind == 'project' %}
  <div class="proj-head">
    {% if b.goal %}<div class="pgoal">{{ b.goal }}</div>{% endif %}
    {% if b['status'] %}<div class="pstatus">{% for line in b['status'] %}<div>{{ line }}</div>{% endfor %}</div>{% endif %}
    <div><span class="backlink" data-roi="link:projects">← Projects</span></div>
  </div>

  {{ legend('project') }}

  <div class="rows">
    {#- The project row stands for the project itself. -#}
    <div class="cap-head">This project</div>
    {% for t in b['head_items'] %}{{ row('projhead', t) }}{% endfor %}
    <div class="cap-head">Actions</div>
    {% for t in b['items'] %}{{ row('project', t) }}{% endfor %}
    {% if not b['items'] %}<div class="empty">Nothing open — every action is ticked off.</div>{% endif %}
    {% if b['done_items'] %}
    <div class="cap-head">Done</div>
      {% for d in b['done_items'] %}<div class="row"><div class="done-item">{{ d }}</div></div>{% endfor %}
    {% endif %}
    <div class="cap-head">+ Add actions to this project</div>
    {% for t in b['capture_items'] %}{{ row('project', t) }}{% endfor %}
  </div>

  {% else %}
  {{ legend(b.key) }}

  <div class="rows">
    {% if b.kind == 'sectioned' %}
      {% for sec in b.sections %}
      <div class="band"><span class="bt">{{ sec.title }}</span><span class="bs">{{ sec.sub }}</span><span class="bc mono">{{ sec['items']|length }}</span></div>
        {% for t in sec['items'] %}{{ row(b.key, t) }}{% endfor %}
        {% if not sec['items'] %}<div class="empty">Nothing parked here.</div>{% endif %}
      {% endfor %}
    {% else %}
      {% for t in b['items'] %}{{ row(b.key, t) }}{% endfor %}
      {% if not b['items'] %}<div class="empty">Empty — nothing to show.</div>{% endif %}
    {% endif %}

    {% if b['capture_items'] %}
    <div class="cap-head">+ Capture — write new items here</div>
      {% for t in b['capture_items'] %}{{ row(b.key, t) }}{% endfor %}
    {% endif %}
  </div>
  {% endif %}

  <div class="foot">
    <span class="mono">{{ b.title }} · {{ date_stamp }}</span>
    <span class="mono">{{ b.page_no }} / {{ total_pages }}</span>
  </div>
</section>
{% endfor %}

</body>
</html>
